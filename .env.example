# Prisma CLI / migrations
DATABASE_URL="mysql://studyos:studyos@127.0.0.1:3306/studyos"

# Prisma 7 MariaDB adapter runtime connection
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="studyos"
DATABASE_PASSWORD="studyos"
DATABASE_NAME="studyos"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"

# V0.1 single-user mode
DEFAULT_USER_EMAIL="dev@studyos.local"
DEFAULT_USER_NAME="StudyOS Learner"

# Server logging
LOG_LEVEL="info"
